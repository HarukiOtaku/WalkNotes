<?xml version="1.0" encoding="utf-8"?>
<!-- The map is the first page and it fills the screen: the tab bar is the only chrome, the walked
     state sits in a small pill, and the one primary action is a big button at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.civicwalk.app.FogMapView
        android:id="@+id/fogMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- walked state, floating over the map -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:alpha="0.94">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kpiCells"
                        style="@style/KpiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />

                    <TextView
                        style="@style/KpiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_cells" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kpiKm"
                        style="@style/KpiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00" />

                    <TextView
                        style="@style/KpiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_km" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRoute"
                style="@style/Hint"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/map_empty" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- street map / offline grid -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapReal"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/map_real"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapGrid"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/map_grid"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLegend"
        style="@style/Hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="80dp"
        android:background="#F2FFFFFF"
        android:padding="6dp"
        android:text="@string/map_legend" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecenter"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="84dp"
        android:minWidth="0dp"
        android:text="@string/btn_recenter" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRoute"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:text="@string/btn_route_start"
        android:textSize="16sp" />
</FrameLayout>
