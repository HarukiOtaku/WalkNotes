<?xml version="1.0" encoding="utf-8"?>
<!-- Map fills the panel. Chrome floats on top, like the reference: compact status, circular
     controls, one fat pill at the bottom. The tab bar lives in activity_main, below this. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.civicwalk.app.FogMapView
        android:id="@+id/fogMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:alpha="0.96"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:contentPadding="12dp"
        app:strokeColor="@color/line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kpiCells"
                        style="@style/KpiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp" />

                    <TextView
                        style="@style/KpiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_cells" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/kpiKm"
                        style="@style/KpiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="20sp" />

                    <TextView
                        style="@style/KpiLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kpi_km" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRoute"
                style="@style/Hint"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/map_empty" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapReal"
            style="@style/MapFab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/map_real" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMapGrid"
            style="@style/MapFab"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/map_grid" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLegend"
        style="@style/Hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/legend_chip"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="@string/map_legend" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecenter"
        style="@style/MapFab"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="84dp"
        android:text="@string/btn_recenter" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRoute"
        style="@style/CtaWalk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_route_start" />
</FrameLayout>
