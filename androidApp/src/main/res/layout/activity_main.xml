<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/panelMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/tab_map" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/panelReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <include layout="@layout/tab_report" />
        </ScrollView>

        <ScrollView
            android:id="@+id/panelRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <include layout="@layout/tab_records" />
        </ScrollView>

        <ScrollView
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <include layout="@layout/tab_settings" />
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/card"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorGravity="top"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/accent_soft"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextAppearance="@style/TabText"
        app:tabTextColor="@color/muted" />
</LinearLayout>
